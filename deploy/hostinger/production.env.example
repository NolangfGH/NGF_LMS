APP_NAME="NGF_C++CodeQuest"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rsmimaropa.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=replace_with_hostinger_database
DB_USERNAME=replace_with_hostinger_database_user
DB_PASSWORD=replace_on_server_only

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=ngf_codequest_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@rsmimaropa.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional integrations: configure only on the production server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_CPP_LANGUAGE_ID=54
