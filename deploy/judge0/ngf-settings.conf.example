# Merge these values into the OFFICIAL Judge0 CE release's judge0.conf.
# Keep that release's DB/Redis host settings and replace all credentials locally.
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_PRIVATE_TOKEN
JUDGE0_TELEMETRY_ENABLE=false
ALLOW_IP=REPLACE_WITH_LARAVEL_SERVER_IP
ENABLE_WAIT_RESULT=false
ENABLE_BATCHED_SUBMISSIONS=true
MAX_SUBMISSION_BATCH_SIZE=8
ENABLE_CALLBACKS=false
ENABLE_ADDITIONAL_FILES=false
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_COMPILER_OPTIONS=true
ALLOWED_LANGUAGES_FOR_COMPILER_OPTIONS=C++
ALLOW_ENABLE_NETWORK=false
ENABLE_NETWORK=false
CPU_TIME_LIMIT=2
MAX_CPU_TIME_LIMIT=2
CPU_EXTRA_TIME=0.5
MAX_CPU_EXTRA_TIME=0.5
WALL_TIME_LIMIT=5
MAX_WALL_TIME_LIMIT=5
MEMORY_LIMIT=128000
MAX_MEMORY_LIMIT=128000
STACK_LIMIT=64000
MAX_STACK_LIMIT=64000
MAX_PROCESSES_AND_OR_THREADS=16
MAX_MAX_PROCESSES_AND_OR_THREADS=16
MAX_FILE_SIZE=64
MAX_MAX_FILE_SIZE=64
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1
MAX_QUEUE_SIZE=100
COUNT=2
